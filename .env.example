# Copy to .env.local and fill in. .env.local is gitignored.
# In Cursor Cloud Agents these are provided via the Secrets panel (injected on new runs).

# --- QnA agent: classification (TypeSafe Jev / System One) ---
# Cheap, structured classification & routing. Get a key from the TypeSafe dashboard.
JEV_KEY=
# Optional overrides:
# TYPESAFE_MODEL=jev-latest

# --- QnA agent: generation (Ollama Cloud, glm-5.3) ---
OLLAMA_API_KEY=
# Optional overrides:
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=glm-5.3

# --- Admin auth (Google SSO + credentials) ---
# Random string used to sign the admin session cookie (required for any admin login).
AUTH_SECRET=
# Google OAuth web client (optional; enables "Sign in with Google").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Extra admin emails (comma-separated). cpar2002@gmail.com is a built-in initial admin.
ADMIN_EMAILS=
# Username/password login (optional). ADMIN_USERNAME defaults to cpar2002@gmail.com.
# Generate the hash with: node scripts/hash-password.mjs "your-password"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
